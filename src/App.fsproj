<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <WarningLevel>3</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core: pure .NET, no browser deps (shared with test project) -->
    <Compile Include="Core\Vec.fs" />
    <Compile Include="Core\Domain.fs" />
    <Compile Include="Core\Maps.fs" />
    <Compile Include="Core\State.fs" />
    <Compile Include="Core\Track.fs" />
    <Compile Include="Core\Spawn.fs" />
    <Compile Include="Core\Arena.fs" />
    <Compile Include="Core\Combat.fs" />
    <Compile Include="Core\Impact.fs" />
    <Compile Include="Core\Kinematics.fs" />
    <Compile Include="Core\Weapons.fs" />
    <Compile Include="Core\Entities.fs" />
    <Compile Include="Core\Collisions.fs" />
    <Compile Include="Core\Rebirth.fs" />
    <Compile Include="Core\Race.fs" />
    <Compile Include="Core\Bot.fs" />
    <Compile Include="Core\Progress.fs" />
    <Compile Include="Core\Strings.fs" />
    <Compile Include="Core\Sim.fs" />
    <Compile Include="Core\Determinism.fs" />
    <!-- Platform: thin browser bindings -->
    <Compile Include="Platform/CrazyGames.fs" />
    <Compile Include="Platform/Input.fs" />
    <Compile Include="Platform\Log.fs" />
    <Compile Include="Platform\Three.fs" />
    <Compile Include="Platform\Sfx.fs" />
    <!-- UI: browser-dependent game screens -->
    <Compile Include="UI\Render\RenderTypes.fs" />
    <Compile Include="UI\Render\RenderMeshes.fs" />
    <Compile Include="UI\Render\RenderFx.fs" />
    <Compile Include="UI\Render\RenderEnt.fs" />
    <Compile Include="UI\Render\RenderHud.fs" />
    <Compile Include="UI\Render\RenderCam.fs" />
    <Compile Include="UI\Render\Render.fs" />
    <Compile Include="UI\Settings.fs" />
    <Compile Include="UI\Menu.fs" />
    <Compile Include="UI\Pad.fs" />
    <!-- Entry point -->
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.*" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.*" />
  </ItemGroup>
</Project>
